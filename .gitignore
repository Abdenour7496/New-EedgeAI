# Environment / secrets — never commit
.env
.env.*
.env copy
!.env.example

# Self-signed dev certs — regenerate locally (see buzz-relay-proxy/certs/san.cnf)
buzz-relay-proxy/certs/*.crt
buzz-relay-proxy/certs/*.key

# Local backups
backups/

# Archives
*.zip

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
dist/
*.egg-info/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db
