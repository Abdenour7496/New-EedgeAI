# Copy this file to .env and fill in your values
# cp .env.example .env

# ── AI Provider keys ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# GitHub classic PAT (ghp_...) — required for OpenClaw to use GitHub Copilot.
# Must be a classic token; fine-grained tokens (github_pat_) are not supported.
# No special scopes needed — just an active Copilot Individual/Business subscription.
COPILOT_API_KEY=ghp_your-github-classic-pat-here

# ── Proxy / RAG configuration ─────────────────────────────────────────────────
# Which LLM backend the GCOR proxy uses when the model is "openclaw".
# openclaw → routes through OpenClaw (recommended, uses Copilot + Ollama fallback)
# openai | anthropic | ollama | copilot
LLM_BACKEND=openclaw
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# Embedding model used for Qdrant semantic search
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant collection to search for RAG context (must match the collection used in ingest.py)
QDRANT_COLLECTION=documents
QDRANT_TOP_K=5

# Set to "false" to disable RAG and use the LLM directly (useful for debugging)
ENABLE_RAG=true

# ── Cognitive infrastructure ───────────────────────────────────────────────────
# Minimum confidence score (0.0–1.0) for retrieved nodes.
# Nodes (Memory, Inference, Belief) below this threshold are discarded before
# the LLM sees them.  0.0 = include everything (default).
CONFIDENCE_THRESHOLD=0.0

# Agent partition — scope Memory/Belief/Inference retrieval to one agent.
# Empty = no partition (all agents' cognitive nodes are visible).
AGENT_ID=

# Default access level applied to newly created nodes.
# public | restricted | agent:<id>
DEFAULT_ACCESS_LEVEL=public

# ── OpenClaw gateway ──────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token
OPENCLAW_GATEWAY_PASSWORD=your-openclaw-gateway-password

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Bot token for the OpenClaw Telegram integration. Leave blank to disable.
TELEGRAM_BOT_TOKEN=

# Optional overrides (defaults shown)
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790
# OPENCLAW_GATEWAY_BIND=lan
# OPENCLAW_CONFIG_DIR=openclaw_config
# OPENCLAW_DOCKER_APT_PACKAGES=

# ── Document storage (MinIO) ──────────────────────────────────────────────────
# Part of the default stack (no profile needed). Two ways documents get in:
#   1. Upload via the knowledge UI (/knowledge or POST /api/ingest) — the proxy
#      also persists the original file to MinIO (bucket/key returned in the
#      response's "storage" field) so it's durable and re-downloadable later.
#   2. Drop a file into the "documents" bucket under inbox/ (mc, aws-cli, or any
#      S3 SDK pointed at http://localhost:9000) — the ingest-watcher container
#      polls that prefix, ingests new files automatically, and moves them to
#      processed/ (success) or failed/ (with a .error.txt) — see
#      ingest-watcher/watcher.py.
# Console: http://localhost:9001 (login with the access/secret key below).
# Change these defaults before exposing MinIO outside a trusted local network.
DOCS_S3_ACCESS_KEY=gcor_docs
DOCS_S3_SECRET_KEY=gcor_docs_secret
DOCS_S3_BUCKET=documents
# How often ingest-watcher polls documents/inbox/ for new files (seconds).
# INGEST_WATCH_INTERVAL_SECONDS=10
# Run the full Document Intelligence pipeline (OCR, tables, entities) on files
# dropped into inbox/. "false" = plain text extraction only (faster, cheaper).
# INGEST_ENABLE_DOCINT=false

# ── Buzz (optional collaboration relay) ─────────────────────────────────────
# Start with: docker compose -f docker-compose.unified.yml --profile buzz up -d
# Change these defaults before exposing Buzz outside a trusted local network.
BUZZ_POSTGRES_PASSWORD=buzz_dev
BUZZ_S3_ACCESS_KEY=buzz_dev
BUZZ_S3_SECRET_KEY=buzz_dev_secret
BUZZ_S3_BUCKET=buzz-media
# Public WebSocket URL advertised by the relay. Keep ws://127.0.0.1:3010 for local use —
# NOT ws://localhost:3010: buzz-acp's native-agent runtime always dials the relay via
# 127.0.0.1 regardless of this setting, and NIP-98 HTTP auth (used by /query and /events,
# unlike NIP-42 WS auth) doesn't alias localhost/127.0.0.1, so a localhost canonical host
# 401s every native agent's ordinary channel-discovery call. Cost: Buzz Desktop's
# onboarding/profile-save call is separately hardcoded to sign against localhost
# regardless of this setting, so it 401s and blocks onboarding for new/unmigrated
# identities (confirmed live in both directions 2026-08-03).
# BUZZ_RELAY_URL=ws://127.0.0.1:3010
# Stable 32-byte hex private key for the relay's own identity. Actually required, not
# just "for production": buzz-admin add-member/remove-member refuses to run without it
# (it signs the kind:13534 membership roster). Without this set, the relay signs with a
# fresh ephemeral key every restart and you can never register a bridge/bot identity.
# Generate with: docker compose -f docker-compose.unified.yml --profile buzz run --rm buzz-migrate generate-key
BUZZ_RELAY_PRIVATE_KEY=

# ── Buzz Knowledge Bridge (optional, requires the `buzz` profile) ───────────────
# Lets both humans and agents retrieve GCOR collections/documents from inside a
# Buzz channel by @mentioning the bridge's agent identity. Two-way, verified
# end-to-end: it reads channel messages and posts the GCOR-retrieved answer
# back into the same thread. Posting is deterministic (buzz-bridge/reply_adapter.py),
# not an LLM tool-call decision — see README's Knowledge Bridge section for why.
# Start with: docker compose -f docker-compose.unified.yml --profile buzz up -d buzz buzz-relay-proxy buzz-agent-bridge
#
# Setup:
#   1. Set BUZZ_RELAY_PRIVATE_KEY above and (re)start buzz:
#      docker compose -f docker-compose.unified.yml --profile buzz up -d buzz
#   2. Generate a *separate* keypair for the bridge's own agent identity (buzz-migrate's
#      entrypoint is already buzz-admin, so `run` just needs the subcommand):
#      docker compose -f docker-compose.unified.yml --profile buzz run --rm buzz-migrate generate-key
#   3. Register the printed pubkey as a relay member, then paste the secret key below:
#      docker compose -f docker-compose.unified.yml --profile buzz run --rm \
#        buzz-migrate add-member --pubkey <public-key-printed-in-step-2> --role member
BUZZ_AGENT_PRIVATE_KEY=
#   4. Give it a display name — not just cosmetic: Buzz's @name mention parsing needs a
#      resolvable profile, so an unnamed identity generally can't be @mentioned by typing
#      at all. Run this via `docker compose run` against the buzz-agent-bridge service
#      (that builds it on demand if needed) so it picks up the network namespace it shares
#      with buzz-relay-proxy, which lets ws://127.0.0.1:3010 actually reach the relay from
#      inside the docker network — running buzz-cli any other way from in here 404s ("no
#      community configured for this host"), since the relay routes purely by the exact
#      Host header a request arrives with:
#      docker compose -f docker-compose.unified.yml --profile buzz run --rm \
#        --entrypoint /usr/local/bin/buzz-cli -e BUZZ_RELAY_URL=ws://127.0.0.1:3010 \
#        -e BUZZ_PRIVATE_KEY=<secret-key-from-step-2> \
#        buzz-agent-bridge users set-profile --name "gcor-bot" --about "..."
#   5. No channel list to configure — buzz-agent-bridge's entrypoint
#      (channel_supervisor.sh) self-joins every open channel automatically on
#      startup and polls every 60s for new ones. For a *private* channel,
#      channel membership is a separate, stronger ACL than relay membership;
#      neither the bridge nor the relay's own admin key can add themselves to
#      one, so an existing owner/admin has to invite its pubkey from the Buzz
#      client once — the bridge picks it up on its next poll, no restart.
#   6. Shared secret between the bridge and the GCOR proxy (openssl rand -hex 32).
#      Required — the proxy's /v1/buzz/chat/completions route is closed without it.
BUZZ_BRIDGE_API_KEY=
# Optional: restrict which Qdrant collections may be queried from Buzz (comma-separated).
# Empty = same collections already reachable via the normal chat pipeline.
BUZZ_ALLOWED_COLLECTIONS=
# Who in an allowed channel may trigger the bridge: anyone | allowlist | owner-only | nobody.
# "anyone" (default) means any member of the allowed channel — human or agent — since the
# channel invite list above is already the access boundary.
BUZZ_ACP_RESPOND_TO=anyone
# Max upload size accepted by POST /v1/buzz/ingest (image attachments and
# storage_key lookups triggered from a Buzz channel). Bytes, default 20 MB.
# BUZZ_BRIDGE_MAX_UPLOAD_BYTES=20971520
