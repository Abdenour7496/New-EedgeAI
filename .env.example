# Copy to .env and replace secrets before exposing the stack.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Proxy API authentication (see docs/adr/0002-proxy-api-authentication.md) ──
# Shared secret required on the proxy's /api/* and /v1/* endpoints. Every
# trusted caller needs the SAME value: openwebui, ingest-watcher, and each
# gcor_* OpenWebUI Function's `gcor_api_key` valve (set those in Admin Panel >
# Functions after installing them). Leaving this blank leaves those endpoints
# UNAUTHENTICATED — fine for an isolated dev box, not for anything reachable
# beyond it. Generate one with e.g. `openssl rand -hex 32`.
GCOR_API_KEY=

# ── OpenWebUI auth (the user-facing interface) ────────────────────────────────
# Persistent JWT/session signing key. Without a fixed value, OpenWebUI
# generates a random one on every restart and silently logs everyone out.
# Generate one with e.g. `openssl rand -hex 32`.
WEBUI_SECRET_KEY=changeme-set-a-real-secret
# Closed after bootstrapping the first admin account (OpenWebUI allows the
# very first signup regardless of this setting — verify against your pinned
# version). Flip to true only temporarily if you need to add more self-serve
# accounts later.
OPENWEBUI_ENABLE_SIGNUP=false

# Main chat backend. OpenClaw uses Codex -> Claude Code -> Ollama.
LLM_BACKEND=openclaw
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# Graphiti knowledge graph. Embeddings default to fully local Ollama.
# Qwen 2.5 7B (GRAPHITI_MODEL) is used as the embedder-adjacent fallback
# model and because Graphiti requires reliable structured JSON.
GRAPHITI_API_BASE_URL=http://ollama:11434/v1
GRAPHITI_API_KEY=ollama
GRAPHITI_MODEL=qwen2.5:7b
GRAPHITI_EMBEDDING_MODEL=nomic-embed-text
GRAPHITI_EMBEDDING_DIM=768
GRAPHITI_GROUP_ID=documents
GRAPHITI_TOP_K=8
ENABLE_RAG=true
# Entity/edge extraction and dedup — separate from embeddings above.
# Defaults to routing through the proxy's openclaw passthrough (Codex/Claude
# Code CLI subscriptions, with automatic Ollama fallback on failure) since
# local qwen2.5:7b extraction can take 30+ minutes on a real multi-message
# document or chat transcript. See docs/adr/0010-graphiti-openclaw-llm.md.
# Uncomment to opt back into local-only extraction (expect it to be slow):
# GRAPHITI_LLM_BASE_URL=http://ollama:11434/v1
# GRAPHITI_LLM_API_KEY=ollama
# GRAPHITI_LLM_MODEL=qwen2.5:7b
# Group used to archive chat-session transcripts (see the
# gcor_chat_session_ingest OpenWebUI filter). Kept separate from
# GRAPHITI_GROUP_ID so document RAG isn't diluted by conversation history.
GRAPHITI_CHAT_SESSIONS_GROUP_ID=chat_sessions
# How long the proxy (and the gcor_* ingest Functions, which match this same
# value) wait for Graphiti extraction before returning an error. Local
# extraction can take several minutes per call if you've opted back into it
# above; the openclaw-routed default needs far less margin.
# GRAPHITI_INGEST_TIMEOUT_SECONDS=1800
# How long a duplicate submission (same content, e.g. a client that timed
# out and retried) is deduped server-side instead of creating a second
# Graphiti episode. See docs/adr/0012-ingest-concurrency-and-idempotency.md.
# INGEST_IDEMPOTENCY_TTL_SECONDS=600

# FalkorDB
FALKORDB_DATABASE=eedgeai
# Empty = no auth on the graph/vector store. Fine while it's bound to
# 127.0.0.1 only (the compose default); set a real password before publishing
# its port more broadly. graphiti, graphiti-mcp, falkordb-exporter, and this
# backup job all read the same value.
FALKORDB_PASSWORD=
# Connection-pool health checking for the graphiti service's own FalkorDB
# client (graphiti-mcp is a separate vendor image, unaffected). Defaults
# baked into graphiti/app.py; override only if the defaults prove
# insufficient. See docs/adr/0016-falkordb-connection-health.md.
# FALKORDB_HEALTH_CHECK_INTERVAL_SECONDS=30
# FALKORDB_SOCKET_TIMEOUT_SECONDS=30
# graphiti self-restarts on this interval — a known, unresolved bug in its
# long-lived FalkorDB connection intermittently hides recent writes from
# /search; a fresh process has always found them correctly in testing, so
# this bounds the staleness window instead of leaving it unbounded. 0
# disables it (not recommended). See
# docs/adr/0017-search-connection-workaround.md.
# SEARCH_RESTART_INTERVAL_SECONDS=900

# Ollama chat/vision defaults
OLLAMA_MODEL=llama3.2
# Also feeds openwebui's RAG_EMBEDDING_MODEL (its own file-attach RAG, not
# Graphiti) — if you change this, OpenWebUI's *already-persisted* config
# still needs a manual update too (Admin Panel > Settings > Documents), it
# won't pick up a new env var value on its own. See
# docs/adr/0008-openwebui-embedding-model-mismatch.md.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b

# OpenClaw
OPENCLAW_GATEWAY_TOKEN=replace-me
TELEGRAM_BOT_TOKEN=
# After first start, authenticate the two subscription providers interactively:
# docker exec -it eedgeai-openclaw-1 node openclaw.mjs models auth login --provider openai
# docker exec -it eedgeai-openclaw-1 claude login

# MinIO document originals
DOCS_S3_ACCESS_KEY=gcor_docs
DOCS_S3_SECRET_KEY=replace-me
DOCS_S3_BUCKET=documents
# INGEST_WATCH_INTERVAL_SECONDS=10
# INGEST_ENABLE_DOCINT=false

# Edge TTS
TTS_API_KEY=tts-local
TTS_DEFAULT_VOICE=en-US-AriaNeural
TTS_DEFAULT_FORMAT=mp3

# Grafana — default is admin/admin otherwise.
GRAFANA_ADMIN_PASSWORD=changeme

# Backups (see backup/README.md). Defaults: snapshot every 6h, keep 14 days.
# BACKUP_INTERVAL_SECONDS=21600
# BACKUP_RETENTION_DAYS=14
